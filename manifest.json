{
  "manifest_version": 3,
  "name": "Flow",
  "version": "2.0",
  "description": "Block distractions on YouTube and Reddit",
  "author": "Flow Extension",
  "homepage_url": "https://github.com/alanphoon/Flow",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-blocker.js"],
      "css": ["youtube-blocker.css"]
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["social-blocker.js"],
      "css": ["social-blocker.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/bird.png",
      "48": "images/bird.png",
      "128": "images/bird.png"
    }
  },
  "icons": {
    "16": "images/bird.png",
    "48": "images/bird.png",
    "128": "images/bird.png"
  }
}
